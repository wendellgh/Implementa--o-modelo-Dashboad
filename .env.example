# Aplicacao (prefira a URL pooled do Neon para o Streamlit)
DATABASE_URL=

# Scripts de migracao (prefira a URL direta do Neon)
NEON_DATABASE_URL=
LOCAL_DATABASE_URL=

# Alternativa por campos separados
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Gere um valor aleatorio forte e mantenha-o apenas no secret store/.env local
DASHBOARD_AUTH_SECRET=
DASHBOARD_AUTH_TTL_HOURS=12

# Oracle
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_CLIENT_LIB_DIR=
